# Normalize text files and force Linux-consumed files to LF on Windows checkouts.
* text=auto

*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.sudoers text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.env text eol=lf

# Extensionless POSIX scripts also need an explicit LF rule.
appliance/factory-reset/beam-appliance-* text eol=lf
appliance/provisioning/beammp-authkey-configured text eol=lf
appliance/update/beam-appliance-* text eol=lf

*.ps1 text eol=crlf
