# Optional overrides. Load this file explicitly with BEAM_MANAGER_ENV_FILE.
BEAM_MANAGER_HOST=127.0.0.1
BEAM_MANAGER_PORT=8765
BEAM_MANAGER_REQUIRE_AUTH=false
BEAM_MANAGER_LAN_NETWORK=
BEAM_MANAGER_LANGUAGE=fr
BEAM_MANAGER_TIMEZONE=UTC
BEAM_MANAGER_DATA_DIR=/var/lib/beam-manager
BEAM_MANAGER_SESSION_SECRET_FILE=/etc/beam-manager/session.secret
BEAM_SERVER_BACKEND=local
BEAM_SERVER_HOST=127.0.0.1
BEAM_SERVER_PORT=30814
BEAM_SYSTEMD_SERVICE=beammp
BEAM_ROOT=/opt/beammp
BEAM_CONFIG_PATH=/opt/beammp/ServerConfig.toml
BEAM_ACTIVE_MODS_PATH=/opt/beammp/Resources/Client
BEAM_DISABLED_MODS_PATH=/opt/beammp/DisabledMods
BEAM_BACKUPS_PATH=/opt/beammp/Backups
BEAM_LOG_PATH=/opt/beammp/Server.log
BEAM_OLD_LOG_PATH=/opt/beammp/Server.old.log
BEAM_TELEMETRY_PATH=/opt/beammp/Resources/Server/BeamServerManager/telemetry.json
BEAM_UPLOAD_MAX_BYTES=2147483648
BEAM_INTERNET_TIMEOUT=15
BEAM_MANAGER_ALLOW_DEMO=false
BEAMMP_GITHUB_REPOSITORY=BeamMP/BeamMP-Server

# Remote profiles only; unused by the primary LocalLinuxBackend profile.
BEAM_SSH_USER=beammanager
BEAM_SSH_KEY_PATH=~/.ssh/id_ed25519
BEAM_SSH_TIMEOUT=8
